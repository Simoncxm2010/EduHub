# 服务端口（默认 8787）
PORT=8787
# JWT 签名密钥：生产环境务必改成随机长字符串（不设置时服务会自动生成并保存到 server/data/.jwt_secret）
JWT_SECRET=please-change-me-to-a-long-random-string
# 法定节假日自动同步：默认开启，进程启动时同步一次、之后每天一次（内网离线部署可设为 0，只用内置数据）
EDUHUB_HOLIDAY_SYNC=1
# 同步间隔小时数（默认 24）
EDUHUB_HOLIDAY_SYNC_HOURS=24
# 节假日数据源地址前缀（默认 https://timor.tech/api/holiday/year/，末尾拼接年份）
# EDUHUB_HOLIDAY_SOURCE_URL=https://timor.tech/api/holiday/year/

# ===== 大模型识别接口（可选，用于把「学生有空时间」的口语描述/聊天截图转成结构化时段）=====
# 不配置时自动使用内置规则解析：文字描述照样能识别，只是不支持图片。
# 兼容 OpenAI 的 /chat/completions 协议，改 BASE_URL + MODEL 即可对接
# DeepSeek / Moonshot / 智谱 / 本地 Ollama、vLLM 等。
# EDUHUB_LLM_API_KEY=sk-xxxxxxxx
# EDUHUB_LLM_BASE_URL=https://api.deepseek.com/v1
# EDUHUB_LLM_MODEL=deepseek-chat
# 关闭图片识别（模型不支持视觉时设成 0）
# EDUHUB_LLM_VISION=1
# 单次识别超时（毫秒，默认 30000）
# EDUHUB_LLM_TIMEOUT_MS=30000
